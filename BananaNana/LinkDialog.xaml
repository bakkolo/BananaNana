<Window x:Class="BananaNana.LinkDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Link" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"><StackPanel Margin="14"><TextBlock Text="Text to show"/><TextBox x:Name="TextBox" Margin="0,4,0,10"/><TextBlock Text="Address (https://…, example.com or name@example.com)"/><TextBox x:Name="UrlBox" Margin="0,4,0,4"/><TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Text="Enter a web address (http/https) or an email address."/><DockPanel Margin="0,12,0,0"><Button x:Name="RemoveButton" Content="Remove link" Click="Remove_Click" Padding="12,6" Visibility="Collapsed" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="OK" Click="Ok_Click" IsDefault="True" Padding="16,6"/><Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" Padding="12,6"/></StackPanel></DockPanel></StackPanel></Window>
