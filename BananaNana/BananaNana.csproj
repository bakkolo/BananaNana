<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><!-- Windows Forms only for the tray icon (NotifyIcon), per docs/RESEARCH.md. --><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><!-- The UI is English: skip .NET's translated framework messages (~5 MB in the standalone EXE). --><SatelliteResourceLanguages>en</SatelliteResourceLanguages><!-- WPF0001: Application.ThemeMode (Fluent theme) is marked experimental in .NET 10. --><NoWarn>$(NoWarn);WPF0001</NoWarn><ApplicationIcon>BananaNana.ico</ApplicationIcon><!-- Shown in the EXE's Properties > Details; matches the GitHub release tag. --><Version>1.1.0</Version><Product>Banana Nana</Product><Description>Banana Nana text expander</Description><Copyright>© 2026 bakkolo</Copyright></PropertyGroup><ItemGroup><!-- WinForms' implicit usings would clash with WPF types (Application, MessageBox, Clipboard...). --><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /><Resource Include="BananaNana.ico" /></ItemGroup></Project>
