<Window x:Class="BananaNana.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edytor" Width="760" Height="550"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Skrót (bez spacji, np. ;oferta)"/><TextBox x:Name="TriggerBox" Margin="0,4,0,10"/><ToolBar><Button Content="B" FontWeight="Bold" Click="Bold_Click" ToolTip="Pogrubienie (Ctrl+B)"/><Button Content="I" FontStyle="Italic" Click="Italic_Click" ToolTip="Kursywa (Ctrl+I)"/><Button Content="U" Click="Underline_Click" ToolTip="Podkreślenie (Ctrl+U)"/><Separator/><Button Content="• Lista" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" ToolTip="Lista punktowana"/><Button Content="1. Lista" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" ToolTip="Lista numerowana"/><Separator/><Button Content="Wstaw obraz" Click="Image_Click" ToolTip="Wstaw obraz z pliku lub wklej go Ctrl+V"/></ToolBar></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Zapisz" Click="Save_Click" IsDefault="False" Padding="12,6"/><Button Content="Anuluj" Click="Cancel_Click" IsCancel="True" Margin="8,0" Padding="12,6"/></StackPanel><RichTextBox x:Name="Editor" VerticalScrollBarVisibility="Auto" AcceptsTab="True"/></DockPanel></Window>
