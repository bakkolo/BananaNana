<Window x:Class="BananaNana.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edytor" Width="760" Height="550"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Skrót"/><TextBox x:Name="TriggerBox" Margin="0,4,0,10"/><ToolBar><Button Content="B" FontWeight="Bold" Click="Bold_Click"/><Button Content="I" FontStyle="Italic" Click="Italic_Click"/><Button Content="U" Click="Underline_Click"/><Button Content="Wstaw obraz" Click="Image_Click"/></ToolBar></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Zapisz" Click="Save_Click" Padding="12,6"/><Button Content="Anuluj" Click="Cancel_Click" Margin="8,0" Padding="12,6"/></StackPanel><RichTextBox x:Name="Editor" VerticalScrollBarVisibility="Auto"/></DockPanel></Window>