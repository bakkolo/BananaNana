<Window x:Class="BananaNana.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Editor" Width="760" Height="550"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Trigger (no spaces, e.g. ;offer)"/><TextBox x:Name="TriggerBox" Margin="0,4,0,10"/><ToolBar><Button Content="B" FontWeight="Bold" Click="Bold_Click" ToolTip="Bold (Ctrl+B)"/><Button Content="I" FontStyle="Italic" Click="Italic_Click" ToolTip="Italic (Ctrl+I)"/><Button Content="U" Click="Underline_Click" ToolTip="Underline (Ctrl+U)"/><Separator/><Button Content="Left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" ToolTip="Align left (Ctrl+L)"/><Button Content="Center" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" ToolTip="Center (Ctrl+E)"/><Button Content="Right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" ToolTip="Align right (Ctrl+R)"/><Separator/><Button Content="• List" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" ToolTip="Bulleted list"/><Button Content="1. List" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" ToolTip="Numbered list"/><Separator/><Button Content="Insert image" Click="Image_Click" ToolTip="Insert an image from a file, or paste one with Ctrl+V"/></ToolBar></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Save" Click="Save_Click" Padding="12,6"/><Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="8,0" Padding="12,6"/></StackPanel><RichTextBox x:Name="Editor" VerticalScrollBarVisibility="Auto" AcceptsTab="True"/></DockPanel></Window>
