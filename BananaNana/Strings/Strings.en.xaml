  <!-- Help and welcome -->
  <sys:String x:Key="Help.Title">Help and tips</sys:String>
  <sys:String x:Key="Help.Welcome">Welcome to Banana Nana</sys:String>
  <sys:String x:Key="Help.Intro">Type a short trigger anywhere and Banana Nana replaces it with your saved text, formatting and pictures.</sys:String>
  <sys:String x:Key="Help.S1.Title">Create a snippet</sys:String>
  <sys:String x:Key="Help.S1.Body">Click New snippet. Choose a trigger such as ;offer, write or paste the content, then Save. Start triggers with a symbol like ; so they never appear in normal words.</sys:String>
  <sys:String x:Key="Help.S2.Title">Use it anywhere</sys:String>
  <sys:String x:Key="Help.S2.Body">In Word, Outlook, Teams or any other app, type the trigger followed by a space. The trigger disappears and the snippet is pasted. Enter never expands, so nothing gets sent by accident.</sys:String>
  <sys:String x:Key="Help.S3.Title">Format and link</sys:String>
  <sys:String x:Key="Help.S3.Body">Use the toolbar for bold, lists and alignment. Paste from Word to keep its formatting. Press Ctrl+K to add a link.</sys:String>
  <sys:String x:Key="Help.S4.Title">Pictures</sys:String>
  <sys:String x:Key="Help.S4.Body">Insert an image or paste a screenshot. Click it and drag a corner to resize it; double-click it to add arrows, frames and highlights.</sys:String>
  <sys:String x:Key="Help.S5.Title">Runs in the background</sys:String>
  <sys:String x:Key="Help.S5.Body">Closing the window keeps Banana Nana in the tray next to the clock. Right-click the icon to pause or exit, and turn on Start with Windows in Settings.</sys:String>
  <sys:String x:Key="Help.TipsTitle">Tips</sys:String>
  <sys:String x:Key="Help.GotIt">Got it</sys:String>

  <!-- Tips (shown in the main window and the help window) -->
  <sys:String x:Key="Tip.1">Start triggers with ; or / so they never clash with real words.</sys:String>
  <sys:String x:Key="Tip.2">Your clipboard is restored after each paste, so copy and paste keep working as usual.</sys:String>
  <sys:String x:Key="Tip.3">Pause expansion from the tray icon when you need to type a trigger literally.</sys:String>
  <sys:String x:Key="Tip.4">Export your library to back it up or to share it with a colleague.</sys:String>
  <sys:String x:Key="Tip.5">Pictures are pasted at the size you see in the editor, so shrink big screenshots before saving.</sys:String>
  <sys:String x:Key="Tip.6">Put BananaNana.library.json next to the EXE to carry your snippets on a USB stick.</sys:String>
  <sys:String x:Key="Tip.7">Ctrl+click a link in the editor to check where it goes.</sys:String>
  <sys:String x:Key="Tip.8">The search box filters your snippets as you type.</sys:String>
