<Window x:Class="BananaNana.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Banana Nana" Width="980" Height="650"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Nowy" Click="New_Click" Padding="12,6"/><Button Content="Importuj" Click="Import_Click" Margin="8,0" Padding="12,6"/><Button Content="Eksportuj" Click="Export_Click" Padding="12,6"/><Button Content="Ustawienia" Click="Settings_Click" Margin="8,0" Padding="12,6"/><ToggleButton x:Name="PauseToggle" Content="Pauza" Click="Pause_Click" Padding="12,6" ToolTip="Wstrzymaj rozwijanie skrótów"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="Gray" Text="Rozwijanie skrótów włączone: wpisz skrót i spację w dowolnym programie."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel Margin="0,0,12,0"><TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="Search_Changed"/><ListBox x:Name="SnippetsList" DisplayMemberPath="Trigger" MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged"/></DockPanel><GroupBox Grid.Column="1" Header="Podgląd"><RichTextBox x:Name="Preview" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/></GroupBox></Grid></DockPanel></Window>
