<Window x:Class="BananaNana.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banana Nana" Width="1060" Height="700" MinWidth="760" MinHeight="480">
  <!-- Texts come from Strings/Strings.xx.xaml (DynamicResource) so the language can change at runtime.
       AutomationProperties.Name stays English: it identifies controls for UI automation. -->
  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: name + library summary, actions on the right -->
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource IconButton}" Content="&#xE896;" Click="Import_Click" ToolTip="{DynamicResource Main.Import}" AutomationProperties.Name="Import" />
        <Button Style="{StaticResource IconButton}" Content="&#xE898;" Click="Export_Click" ToolTip="{DynamicResource Main.Export}" AutomationProperties.Name="Export" />
        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="{DynamicResource Main.Settings}" AutomationProperties.Name="Settings" />
        <Button Style="{StaticResource IconButton}" Content="&#xE897;" Click="Help_Click" ToolTip="{DynamicResource Main.Help}" AutomationProperties.Name="Help" Margin="0,0,12,0" />
        <Button Style="{DynamicResource AccentButtonStyle}" Click="New_Click" Padding="14,7" AutomationProperties.Name="New">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="{DynamicResource Main.New}" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Banana Nana" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="LibraryText" Style="{StaticResource Caption}" Margin="1,2,0,0" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Snippet list card -->
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="10">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="34,6,8,6" AutomationProperties.Name="Search" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="12,0,0,0" Opacity="0.6" IsHitTestVisible="False" HorizontalAlignment="Left" />
            <TextBlock x:Name="SearchHint" Text="{DynamicResource Main.Search}" Margin="35,0,0,0" Opacity="0.5" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>

          <!-- Rotating tip -->
          <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <DockPanel>
              <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="16" Foreground="#F2B600" VerticalAlignment="Top" Margin="0,1,10,0" />
              <StackPanel>
                <TextBlock x:Name="TipText" TextWrapping="Wrap" FontSize="12.5" />
                <Button Content="{DynamicResource Main.NextTip}" Click="NextTip_Click" HorizontalAlignment="Left" Padding="0" Margin="0,6,0,0"
                        Background="Transparent" BorderThickness="0" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Cursor="Hand" AutomationProperties.Name="Next tip" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Grid>
            <ListBox x:Name="SnippetsList" MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,5">
                    <TextBlock Text="{Binding Trigger}" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource Main.Empty}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.6" Margin="20" />
          </Grid>
        </DockPanel>
      </Border>

      <!-- Preview of the selected snippet -->
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
          <StackPanel x:Name="SelectionActions" DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Click="CopyImage_Click" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="Copy as image">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="{DynamicResource Main.CopyImage}" />
              </StackPanel>
            </Button>
            <Button Click="Edit_Click" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="Edit">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="{DynamicResource Main.Edit}" />
              </StackPanel>
            </Button>
            <Button Click="Delete_Click" Padding="12,6" AutomationProperties.Name="Delete">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="{DynamicResource Main.Delete}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PreviewTitle" FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Main.PreviewCaption}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
        <Border CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="White">
          <RichTextBox x:Name="Preview" Style="{StaticResource Paper}" IsReadOnly="True" BorderThickness="0" Margin="2" />
        </Border>
      </DockPanel>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <ToggleButton x:Name="PauseToggle" DockPanel.Dock="Right" Click="Pause_Click" Padding="12,5" ToolTip="{DynamicResource Main.PauseTip}" AutomationProperties.Name="Pause">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="PauseIcon" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="13" Margin="0,0,8,0" />
          <TextBlock x:Name="PauseLabel" />
        </StackPanel>
      </ToggleButton>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#2EA043" Margin="2,0,10,0" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
