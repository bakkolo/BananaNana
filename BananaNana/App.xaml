<Application x:Class="BananaNana.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown" ThemeMode="System">
  <!-- No StartupUri: App.OnStartup enforces a single instance and may start hidden in the tray (- -tray). -->
  <!-- ThemeMode=System: WPF's Fluent (Windows 11) theme, following the Windows light/dark setting and accent colour. -->
  <Application.Resources>
    <!-- Segoe Fluent Icons ships with Windows 11; Segoe MDL2 Assets is the Windows 10 fallback with the same codes. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Square toolbar button showing one icon glyph (Content) with a tooltip. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,6,10,6" />
      <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- Snippet content is shown on white "paper" in both themes: it is what lands in Word or Teams. -->
    <Style x:Key="Paper" TargetType="RichTextBox" BasedOn="{StaticResource {x:Type RichTextBox}}">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="Black" />
      <!-- FlowDocument defaults to Georgia; pasted text takes the target app's font anyway. -->
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </Application.Resources>
</Application>
