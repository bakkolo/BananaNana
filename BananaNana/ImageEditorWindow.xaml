<Window x:Class="BananaNana.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit image" Width="1000" Height="740" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <!-- Tool buttons: radio behaviour, toggle-button look -->
    <Style x:Key="Tool" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="GroupName" Value="Tool" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Color" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="0" />
              <Ellipse Fill="{TemplateBinding Background}" Margin="4" Stroke="#40000000" StrokeThickness="1" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="24,18,24,18">
    <Border DockPanel.Dock="Top" Padding="8,6" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <WrapPanel VerticalAlignment="Center">
        <RadioButton Style="{StaticResource Tool}" Tag="Select" Checked="Tool_Checked" AutomationProperties.Name="Select" ToolTip="Click a shape to select it, drag to move it, Delete to remove it">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="Select" /></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Tool}" Tag="Arrow" Checked="Tool_Checked" IsChecked="True" AutomationProperties.Name="Arrow" ToolTip="Drag from the tail to the tip">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="Arrow" /></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Tool}" Tag="Rectangle" Checked="Tool_Checked" AutomationProperties.Name="Rectangle" ToolTip="Drag to draw a frame">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE739;" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="Frame" /></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Tool}" Tag="Highlight" Checked="Tool_Checked" AutomationProperties.Name="Highlight" ToolTip="Drag to mark like a highlighter pen">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E6;" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="Highlight" /></StackPanel>
        </RadioButton>
        <Border Style="{StaticResource ToolSeparator}" />
        <RadioButton Style="{StaticResource Swatch}" Background="#E53935" Checked="Color_Checked" IsChecked="True" ToolTip="Red" AutomationProperties.Name="Red" />
        <RadioButton Style="{StaticResource Swatch}" Background="#FFEB3B" Checked="Color_Checked" ToolTip="Yellow" AutomationProperties.Name="Yellow" />
        <RadioButton Style="{StaticResource Swatch}" Background="#43A047" Checked="Color_Checked" ToolTip="Green" AutomationProperties.Name="Green" />
        <RadioButton Style="{StaticResource Swatch}" Background="#1E88E5" Checked="Color_Checked" ToolTip="Blue" AutomationProperties.Name="Blue" />
        <RadioButton Style="{StaticResource Swatch}" Background="#212121" Checked="Color_Checked" ToolTip="Black" AutomationProperties.Name="Black" />
        <Border Style="{StaticResource ToolSeparator}" />
        <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo the last shape (Ctrl+Z)" AutomationProperties.Name="Undo" />
        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Delete_Click" ToolTip="Delete the selected shape (Delete)" AutomationProperties.Name="Delete" />
      </WrapPanel>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" IsCancel="True" Padding="16,7" Margin="0,0,8,0" />
      <Button Content="Save" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" Padding="22,7" />
    </StackPanel>
    <Border Margin="0,10,0,0" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
        <Canvas x:Name="Surface" ClipToBounds="True" Background="Transparent" Cursor="Cross"
                MouseLeftButtonDown="Surface_MouseDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseUp">
          <Image x:Name="Picture" Stretch="Fill" IsHitTestVisible="False" />
        </Canvas>
      </Viewbox>
    </Border>
  </DockPanel>
</Window>
