<Window x:Class="BananaNana.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Set.Title}" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,20">
    <TextBlock Text="{DynamicResource Set.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

    <Border Padding="16,14" CornerRadius="8" Margin="0,0,0,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <DockPanel>
        <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="160" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="Language_Changed" AutomationProperties.Name="Language" />
        <StackPanel>
          <TextBlock Text="{DynamicResource Set.Language}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,12,0" Text="{DynamicResource Set.LanguageHint}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Padding="16,14" CornerRadius="8" Margin="0,0,0,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <DockPanel>
        <CheckBox x:Name="AutostartBox" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Autostart_Click" AutomationProperties.Name="Start with Windows" />
        <StackPanel>
          <TextBlock Text="{DynamicResource Set.Autostart}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,12,0" Text="{DynamicResource Set.AutostartHint}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Padding="16,14" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Set.OpenFolder}" Click="OpenFolder_Click" Padding="12,6" VerticalAlignment="Center" AutomationProperties.Name="Open folder" />
        <StackPanel>
          <TextBlock x:Name="LibraryName" FontWeight="SemiBold" />
          <TextBlock x:Name="LibraryPath" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,12,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Button Content="{DynamicResource Common.Close}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Padding="20,7" Margin="0,18,0,0" AutomationProperties.Name="Close" />
  </StackPanel>
</Window>
