<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BananaNana.Desktop.GuideMakerWindow"
        Title="Guide maker" Width="880" Height="720" MinWidth="560" MinHeight="420">
  <!-- Two views in one window: the list of guides, and one guide being edited. Texts and step cards are set in code. -->
  <Grid Margin="24,18,24,14">
    <DockPanel x:Name="ListView">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <TextBlock x:Name="HeadingText" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="NewButton" Grid.Column="1" Classes="accent" Padding="14,7" Click="New_Click">
          <StackPanel Orientation="Horizontal">
            <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" Margin="0,0,8,0" />
            <TextBlock x:Name="NewLabel" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock x:Name="EmptyText" Opacity="0.6" TextWrapping="Wrap" Margin="2,30,0,0" IsVisible="False" />
      <ScrollViewer>
        <StackPanel x:Name="GuideList" Spacing="8" Margin="0,0,10,0" />
      </ScrollViewer>
    </DockPanel>

    <DockPanel x:Name="GuideView" IsVisible="False">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,14">
        <Button x:Name="BackButton" Padding="12,6" Click="Back_Click">
          <StackPanel Orientation="Horizontal">
            <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14" Margin="0,0,8,0" />
            <TextBlock x:Name="BackLabel" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="StatusText" Grid.Column="1" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
      <ScrollViewer>
        <StackPanel Spacing="14" Margin="2,0,12,0">
          <TextBox x:Name="TitleBox" FontSize="24" FontWeight="SemiBold" />
          <TextBox x:Name="IntroBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
          <StackPanel x:Name="StepPanel" Spacing="12" />
          <Button x:Name="AddStepButton" HorizontalAlignment="Left" Padding="14,7" Margin="0,4,0,0" Click="AddStep_Click" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
