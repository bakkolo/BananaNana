<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BananaNana.Desktop.SettingsWindow"
        Title="Settings" Width="580" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Layout follows the Windows SettingsWindow.xaml: rounded cards with a bold title, a grey hint and the control on the right. -->
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

    <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
      <DockPanel>
        <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="160" VerticalAlignment="Center" SelectionChanged="Language_Changed" />
        <StackPanel>
          <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" />
          <TextBlock x:Name="LanguageHint" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,3,12,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
      <DockPanel>
        <CheckBox x:Name="AutostartBox" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Autostart_Click" />
        <StackPanel>
          <TextBlock x:Name="AutostartLabel" FontWeight="SemiBold" />
          <TextBlock x:Name="AutostartHint" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,3,12,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
      <DockPanel>
        <CheckBox x:Name="StartPausedBox" DockPanel.Dock="Right" VerticalAlignment="Center" Click="StartPaused_Click" />
        <TextBlock x:Name="StartPausedLabel" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <Border Classes="card" Padding="16,14">
      <DockPanel>
        <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Padding="12,6" VerticalAlignment="Center" Click="OpenFolder_Click" />
        <StackPanel>
          <TextBlock x:Name="LibraryName" FontWeight="SemiBold" />
          <TextBlock x:Name="LibraryPath" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,3,12,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock x:Name="ErrorText" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,8,0,0" />

    <Button x:Name="CloseButton" HorizontalAlignment="Right" Padding="20,7" Margin="0,18,0,0" Click="Close_Click" />
  </StackPanel>
</Window>
