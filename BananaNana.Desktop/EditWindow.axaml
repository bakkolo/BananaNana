<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BananaNana.Desktop.EditWindow"
        Title="Edit snippet" Width="620" Height="580" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="22,18,22,18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Padding="14,6" Click="Cancel_Click" />
      <Button x:Name="SaveButton" Classes="accent" Padding="14,6" Click="Save_Click" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,10,0,0" />

    <StackPanel Spacing="8">
      <TextBlock x:Name="TriggerLabel" FontWeight="SemiBold" />
      <TextBox x:Name="TriggerBox" FontFamily="monospace" />
      <TextBlock x:Name="TriggerHint" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />

      <!-- A snippet with formatting or pictures: the text editor below keeps only plain text. -->
      <Border x:Name="NoticeBorder" Classes="card" Padding="12,8" Margin="0,6,0,0" IsVisible="False">
        <TextBlock x:Name="Notice" TextWrapping="Wrap" />
      </Border>

      <TextBlock x:Name="TextLabel" FontWeight="SemiBold" Margin="0,8,0,0" />
      <TextBox x:Name="TextEditor" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" />
    </StackPanel>
  </DockPanel>
</Window>
