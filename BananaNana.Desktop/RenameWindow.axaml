<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BananaNana.Desktop.RenameWindow"
        Title="Rename trigger" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22,18,22,18" Spacing="10">
    <TextBlock x:Name="TriggerLabel" FontWeight="SemiBold" />
    <TextBox x:Name="TriggerBox" FontFamily="monospace" />
    <TextBlock x:Name="TriggerHint" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
    <TextBlock x:Name="ErrorText" Foreground="#C42B1C" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="CancelButton" Padding="14,6" Click="Cancel_Click" />
      <Button x:Name="SaveButton" Classes="accent" Padding="14,6" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>
