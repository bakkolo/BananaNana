<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BananaNana.Desktop.ImageMarkupWindow"
        Title="Mark up picture" Width="1100" Height="780" MinWidth="700" MinHeight="480">
  <!-- The toolbar buttons and the picture are made in code (ImageMarkupWindow.axaml.cs). -->
  <DockPanel Margin="20,16,20,16">
    <Border DockPanel.Dock="Top" Padding="8,6" CornerRadius="8"
            Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
      <WrapPanel x:Name="Toolbar" VerticalAlignment="Center" />
    </Border>
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
      <Button x:Name="ResetCropButton" Grid.Column="0" Padding="12,6" Click="ResetCrop_Click" IsVisible="False" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Padding="16,7" Click="Cancel_Click" />
        <Button x:Name="DoneButton" Classes="accent" Padding="22,7" Click="Done_Click" />
      </StackPanel>
    </Grid>
    <Border Margin="0,10,0,0" CornerRadius="8" Background="{DynamicResource SubtleBackground}"
            BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" ClipToBounds="True">
      <Grid x:Name="Host" />
    </Border>
  </DockPanel>
</Window>
