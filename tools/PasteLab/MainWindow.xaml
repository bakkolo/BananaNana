<Window x:Class="PasteLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banana Nana · Paste Lab" Width="980" Height="820" Topmost="True">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
      Click a variant, switch to the target app, press Ctrl+V. Record what you see in docs/COMPAT.md.
      Each variant pastes: a bold/italic/underlined line with Polish characters, a 3-item list, and a yellow "Banana Nana" image.
    </TextBlock>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,12,0">
        <StackPanel x:Name="Variants" DockPanel.Dock="Top" />
        <TextBlock DockPanel.Dock="Top" Margin="0,6,0,4" TextWrapping="Wrap"
                   Text="Stage 2 engine: edit or paste anything below. It is saved and reloaded like the real editor (XamlPackage) before rendering." />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button Content="G.  Render editor → clipboard (text + RTF + HTML)" Click="Render_Click" Padding="10,8" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
          <Button Content="H.  Paste into the next window in 3 s (with clipboard restore)" Click="DelayedPaste_Click" Padding="10,8" HorizontalContentAlignment="Left" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="LiveToggle" Content="Live: typing " VerticalAlignment="Center" Checked="Live_Changed" Unchecked="Live_Changed" />
            <TextBox x:Name="TriggerBox" Text=";bn" Width="70" VerticalAlignment="Center" TextChanged="Trigger_Changed" />
            <TextBlock Text=" + space anywhere pastes the editor" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <RichTextBox x:Name="Editor" VerticalScrollBarVisibility="Auto" MinHeight="120" />
      </DockPanel>
      <DockPanel Grid.Column="1">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <Button Content="Inspect clipboard" Click="Inspect_Click" Padding="10,4" />
          <TextBlock Text="  Tip: copy from Word/Outlook/Teams, then inspect to see what they produce." VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>
        <TextBox x:Name="Inspector" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
